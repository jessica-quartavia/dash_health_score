# Copie para .env e preencha localmente.
# Use as mesmas variáveis do projeto Jornada de Clientes / dash-simplificado.
# Nunca versionar segredos.

# BASE QV — somente leitura (obrigatória)
DATA_SUPABASE_URL=
DATA_SUPABASE_SERVICE_ROLE_KEY=

# Porta local (opcional)
# PORT=3010

# Monitoramento HS (Etapa 11) — projeto/bucket DEDICADO (não reutilizar DATA_*)
# HS_MONITORING_ROOT=
# MONITORING_MIRROR_PATH=
# MONITORING_SUPABASE_URL=
# MONITORING_SUPABASE_SERVICE_KEY=
# MONITORING_STORAGE_BUCKET=
# MONITORING_SCHEDULE=weekly
# MONITORING_AUTOMATION_APPROVED=0
# MONITORING_CRON_ACTIVE=0

# Business Data — schema _dash_health_score (projeto rckpuebaiswrxzmywllv; NÃO lacinx…)
# BUSINESS_SUPABASE_URL=https://rckpuebaiswrxzmywllv.supabase.co
# Cole a service_role do MESMO projeto (Dashboard → API). Alternativa: AUTH_SUPABASE_SERVICE_ROLE_KEY
# BUSINESS_SUPABASE_SERVICE_ROLE_KEY=
# Exposed schemas na API: incluir _dash_health_score
# npm run monitoring:ensure-secrets  → gera HS_MONITORING_* e MONITORING_PIPELINE_TOKEN (local)
# HS_MONITORING_PSEUDONYM_SECRET=
# HS_MONITORING_PERSIST_BUSINESS_DATA=1
# MONITORING_PIPELINE_TOKEN=
# n8n: MONITORING_PIPELINE_URL=https://<backend-publico> (não localhost)
# GitHub Actions (Etapa 13.2): configurar os mesmos valores como repo Secrets
# MONITORING_GHA_SCHEDULE_ACTIVE=1   # só após descomentar cron no workflow YAML
